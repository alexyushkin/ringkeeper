    "copyright": "Copyright (c) 2026 General Informatics LLC and contributors. MIT License.",
    "homepage": "https://github.com/alexyushkin/ringkeeper",
    "shortDescription": "Ringkeeper",
    "longDescription": "Runs Claude agents on your projects, each bound to its own services, with every risky step waiting for your approval.",
    "category": "DeveloperTool"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNTRCQ0E1NEQ1QjZDNUQKUldSZGJGdE5wYnhVYjF5aUcxeENJSm5xUUpuOUVESGNvZ0Jkc3BEZkM2V0xKV09BaVNZNmlnUDMK",
      "endpoints": [
        "https://github.com/alexyushkin/ringkeeper-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
