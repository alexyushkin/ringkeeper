{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ringkeeper",
  "version": "0.1.0-beta.1",
  "identifier": "com.geninfos.ringkeeper",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
