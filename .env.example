# Ringkeeper's settings. Copy this file to `.env` and change the two values in
# "MUST SET" below; everything else can stay as it is. See docs/INSTALL.md.
#
# Editing tips: no quotes around values, no spaces around `=`. A line starting
# with `#` is ignored: to use a setting, delete the `#` at the start of its line.
# Settings you change later in the web app (Settings screen) win over this file.
# After editing this file, apply it with `docker compose up -d`
# (a plain `docker compose restart` does not re-read it).

# ---------------------------------------------------------------------------
# MUST SET, before the first start
# ---------------------------------------------------------------------------

# The database password: letters and digits only (no @ : / ? # % $ or spaces),
# at least 32 characters. It's fixed when the database is first created, so set
# it before the first `docker compose up`. To make one:
#   Mac/Linux:   openssl rand -hex 24
#   Windows:     -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
POSTGRES_PASSWORD=change-me-to-32-random-letters-and-digits

# The folder that holds your client projects, one subfolder per project (put
# each project's files there, ideally a git repository). In the web app, a
# project's "Folder" is the name of its subfolder, e.g. acme-web.
# Create the folder first. Use forward slashes and no quotes:
#   Windows:  C:/Users/Jane/Clients        (not a OneDrive-synced folder)
#   Mac:      /Users/jane/Clients
#   Server:   /srv/ringkeeper/workspaces
RINGKEEPER_WORKSPACES_ROOT=

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------

# The language you speak to Ringkeeper in (voice notes). Empty detects it,
# which is twice as slow and can guess wrong on short clips.
RINGKEEPER_STT_LANGUAGE=en

# For your phone or a server (docs/INSTALL.md, "Use it from your phone"):
# the web app's HTTPS address from Tailscale Serve, and trusting that proxy.
# RINGKEEPER_WEB_ORIGIN=https://your-machine.your-tailnet.ts.net
# RINGKEEPER_WEB_TRUST_PROXY=1
# The web app answers only on localhost and the address above (so another
# website can't reach it through your browser). Other names it's reached by,
# comma-separated:
# RINGKEEPER_WEB_ALLOWED_HOSTS=ringkeeper.lan

# How many tasks may run at once. Each can use up to 2 GB of memory: on a
# 4 GB server, use 1.
# RINGKEEPER_MAX_CONCURRENT_WORKERS=4

# ---------------------------------------------------------------------------
# Optional: ports (change one if "port is already allocated" at start)
# ---------------------------------------------------------------------------

# Every port is published on 127.0.0.1 only: nothing is reachable from other
# machines unless you add something like Tailscale Serve.
# RINGKEEPER_WEB_PORT=3000
# RINGKEEPER_API_PORT=8000
# RINGKEEPER_GATEWAY_PORT=8100
# RINGKEEPER_DB_PORT=5432  (only with docker-compose.dev.yml)
# RINGKEEPER_DEMO_DB_PORT=5433
# A second install on the same machine needs its own name and workers network
# (and different ports), or its commands would control the first install:
# COMPOSE_PROJECT_NAME=ringkeeper2
# RINGKEEPER_WORKER_NETWORK=ringkeeper2_workers

# ---------------------------------------------------------------------------
# Advanced (the web app sets most of these; developers and the CLI use the rest)
# ---------------------------------------------------------------------------

POSTGRES_USER=ringkeeper
POSTGRES_DB=ringkeeper
# Only for the `uv run ringkeeper` CLI on this machine (not needed otherwise):
# the same password and DB port as above, with Postgres published by
# docker-compose.dev.yml.
# RINGKEEPER_DATABASE_URL=postgresql+psycopg://ringkeeper:<POSTGRES_PASSWORD>@localhost:5432/ringkeeper

# The master key encrypts stored secrets. The api creates .ringkeeper/master.key
# on its first start. To restore after losing master.key, put the key line from
# your recovery key file here (only the key, no quotes).
# RINGKEEPER_DATA_DIR=.ringkeeper
# RINGKEEPER_MASTER_KEY=

# Claude: the web app stores the key and the mode. api_key (default) or
# subscription (personal use on your own account only).
# RINGKEEPER_CLAUDE_AUTH_MODE=api_key

# Lifetimes, in seconds.
# RINGKEEPER_TOKEN_MAX_TTL_SECONDS=86400
# RINGKEEPER_DECISION_TTL_SECONDS=86400

# Router and models (also on the Settings screen). See the README's "Models".
# RINGKEEPER_ROUTER=1
# RINGKEEPER_ROUTER_CONFIDENCE_THRESHOLD=0.8
# RINGKEEPER_MODEL_ROUTER=claude-haiku-5-5
# RINGKEEPER_MODEL_ARCHITECT=claude-opus-5-5
# RINGKEEPER_MODEL_WORKER=claude-sonnet-5-5
# RINGKEEPER_MODEL_LOW=claude-haiku-5-5
# RINGKEEPER_MODEL_MEDIUM=claude-sonnet-5-5
# RINGKEEPER_MODEL_HIGH=claude-opus-5-5

# Telegram (the setup wizard and the Settings screen set these).
# RINGKEEPER_TELEGRAM=1
# RINGKEEPER_TELEGRAM_CHAT_IDS=[123456789]
# RINGKEEPER_TELEGRAM_SUMMARY_CHARS=160
# RINGKEEPER_TELEGRAM_QUESTION_CHARS=1000
# New requests from Telegram (default off): they then pass through Telegram's
# servers, which aren't end-to-end encrypted.
# RINGKEEPER_TELEGRAM_REQUESTS=1
# RINGKEEPER_TELEGRAM_CONFIRM_MINUTES=10

# Voice notes (start with `--profile stt`). Audio is never stored.
# RINGKEEPER_STT_MODEL=small
# RINGKEEPER_STT_MAX_SECONDS=180
# RINGKEEPER_STT_MAX_BYTES=5000000
# Once the model is downloaded, keep the speech service offline:
# RINGKEEPER_STT_OFFLINE=1

# Full transcripts are deleted after this many days (summaries stay).
# RINGKEEPER_RETENTION_DAYS=90
