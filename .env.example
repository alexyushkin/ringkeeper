# Copy to .env for local development. Fake, local-only values: never put real
# credentials here. Service credentials are never stored in Interlock at all;
# instances only hold a secret_ref pointer (file:// or aws-sm://).

POSTGRES_USER=interlock
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=interlock

# Host ports published by docker compose (bound to 127.0.0.1 only).
INTERLOCK_DB_PORT=5432
INTERLOCK_API_PORT=8000
INTERLOCK_GATEWAY_PORT=8100
INTERLOCK_DEMO_DB_PORT=5433

# Used by the CLI on the host. Must match the values above.
INTERLOCK_DATABASE_URL=postgresql+psycopg://interlock:local-dev-only@localhost:5432/interlock

# Vault and master key. By default the CLI creates .interlock/master.key on
# first use and the gateway mounts .interlock read-only. Alternatively put a
# base64 32-byte key here (generate one with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# ). Losing the key loses the vault and every worker token: back it up.
# INTERLOCK_DATA_DIR=.interlock
# INTERLOCK_MASTER_KEY=

# Lifetimes, in seconds.
# INTERLOCK_TOKEN_MAX_TTL_SECONDS=86400
# INTERLOCK_DECISION_TTL_SECONDS=86400
