# Copy to .env for local development. Fake, local-only values: never put real
# credentials here. Service credentials are never stored in Ringkeeper at all;
# instances only hold a secret_ref pointer (file:// or aws-sm://).

POSTGRES_USER=ringkeeper
# Use a strong one: see "Known risks" in the README.
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=ringkeeper

# Host ports published by docker compose (bound to 127.0.0.1 only).
RINGKEEPER_DB_PORT=5432
RINGKEEPER_API_PORT=8000
RINGKEEPER_GATEWAY_PORT=8100
RINGKEEPER_DEMO_DB_PORT=5433

# Used by the CLI on the host. Must match the values above.
RINGKEEPER_DATABASE_URL=postgresql+psycopg://ringkeeper:local-dev-only@localhost:5432/ringkeeper

# Vault and master key. The api creates .ringkeeper/master.key on its first
# start (the CLI does too, if it runs first); the gateway mounts .ringkeeper
# read-only. Alternatively put a base64 32-byte key here: the recovery key from
# the setup wizard is one, so this is also how to restore after losing
# master.key. Without the key, the vault's secrets have to be entered again.
# RINGKEEPER_DATA_DIR=.ringkeeper
# RINGKEEPER_MASTER_KEY=

# Workers. Relative workspace_path values resolve against this folder, as the
# Docker host sees it (a Windows path like C:\work\ringkeeper is fine).
# RINGKEEPER_WORKSPACES_ROOT=
# RINGKEEPER_MAX_CONCURRENT_WORKERS=4
# api_key (the default) gives workers ANTHROPIC_API_KEY; store it with
# `ringkeeper auth login`.
# RINGKEEPER_CLAUDE_AUTH_MODE=api_key

# Lifetimes, in seconds.
# RINGKEEPER_TOKEN_MAX_TTL_SECONDS=86400
# RINGKEEPER_DECISION_TTL_SECONDS=86400

# Router (in the api service) and models. See the README's "Models" table.
# RINGKEEPER_ROUTER=1
# RINGKEEPER_ROUTER_CONFIDENCE_THRESHOLD=0.8
# RINGKEEPER_MODEL_ROUTER=claude-haiku-5-5
# RINGKEEPER_MODEL_ARCHITECT=claude-opus-5-5
# RINGKEEPER_MODEL_WORKER=claude-sonnet-5-5
# RINGKEEPER_MODEL_LOW=claude-haiku-5-5
# RINGKEEPER_MODEL_MEDIUM=claude-sonnet-5-5
# RINGKEEPER_MODEL_HIGH=claude-opus-5-5

# Telegram notifications. Store the bot token with `ringkeeper telegram login`.
# RINGKEEPER_TELEGRAM=1
# RINGKEEPER_TELEGRAM_CHAT_IDS='[123456789]'
# RINGKEEPER_TELEGRAM_SUMMARY_CHARS=160   # approvals, plans, routes
# RINGKEEPER_TELEGRAM_QUESTION_CHARS=1000 # questions
# New requests from Telegram (default off): they then pass through Telegram's
# servers, which aren't end-to-end encrypted. See the README's "Requests from Telegram".
# RINGKEEPER_TELEGRAM_REQUESTS=1
# RINGKEEPER_TELEGRAM_CONFIRM_MINUTES=10

# Voice notes: `docker compose --profile stt up -d`. Audio is never stored.
# RINGKEEPER_STT_MODEL=small
# RINGKEEPER_STT_LANGUAGE=en          # recommended; empty detects it (slower, can guess wrong)
# RINGKEEPER_STT_MAX_SECONDS=180
# RINGKEEPER_STT_MAX_BYTES=5000000
# RINGKEEPER_STT_OFFLINE=1            # once the model is cached

# The web app (http://localhost:3000). Settings changed there win over this file.
# RINGKEEPER_WEB_PORT=3000
# Its HTTPS address (Tailscale Serve, say), needed for passkeys:
# RINGKEEPER_WEB_ORIGIN=https://ringkeeper.your-tailnet.ts.net
# Behind your own HTTPS proxy, count sign-in attempts per device:
# RINGKEEPER_WEB_TRUST_PROXY=1
# Full transcripts are deleted after this many days:
# RINGKEEPER_RETENTION_DAYS=90
