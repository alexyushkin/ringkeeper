# Copy to .env for local development. Fake, local-only values: never put real
# credentials here. Service credentials are never stored in Interlock at all;
# instances only hold a secret_ref pointer (file:// or aws-sm://).

POSTGRES_USER=interlock
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=interlock

# Host ports published by docker compose (bound to 127.0.0.1 only).
INTERLOCK_DB_PORT=5432
INTERLOCK_API_PORT=8000

# Used by the CLI on the host. Must match the values above.
INTERLOCK_DATABASE_URL=postgresql+psycopg://interlock:local-dev-only@localhost:5432/interlock
